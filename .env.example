# ─────────────────────────────────────────────────────────────────────────────
# Travel Technician — environment variables
#
# Copy this file to `.env.local` for local development. Every variable is
# optional for local development: the site runs with built-in fallback content
# and safely disables features whose configuration is missing.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle — never put
# secrets in them. All other variables are server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site URLs ────────────────────────────────────────────────────────────────
# Canonical site URL. Used for metadata, sitemap, canonical links, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.traveltechnician.info

# CardMaster application (separate app — this site only links to it).
NEXT_PUBLIC_CARDMASTER_URL=https://cardmaster.traveltechnician.info

# Existing Travel Technician blog (separate site — this site only links to it).
NEXT_PUBLIC_BLOG_URL=https://blog.traveltechnician.info

# ── Social ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/the_travel_technician
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/TravelTechnician

# ── Scheduling (Calendly) ────────────────────────────────────────────────────
# PLACEHOLDER — leave empty until the real Calendly event link exists.
# When empty, "Schedule a Free Consultation" buttons route to the contact form.
NEXT_PUBLIC_CALENDLY_URL=

# ── Blog RSS integration ─────────────────────────────────────────────────────
# RSS/Atom feed for blog.traveltechnician.info (e.g. https://blog.traveltechnician.info/rss.xml).
# When empty, the Blog page shows CMS-managed (or fallback) featured-post cards.
BLOG_RSS_URL=

# ── Contact form email delivery ──────────────────────────────────────────────
# Provider: "resend" | "postmark". Leave empty to log submissions server-side
# only (useful in development).
EMAIL_PROVIDER=
# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=
# Verified sender address for the chosen provider (e.g. noreply@traveltechnician.info).
EMAIL_FROM_ADDRESS=
# Provider API keys — set only the one matching EMAIL_PROVIDER.
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# ── Analytics (privacy-conscious, consent-gated) ─────────────────────────────
# Provider: "plausible" | "google". Analytics stay fully disabled unless BOTH
# provider and id/domain are set.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible: the site domain (www.traveltechnician.info). Google: the GA4 measurement ID.
NEXT_PUBLIC_ANALYTICS_ID=
# "true" only when the configured analytics are cookieless (e.g. Plausible),
# which relaxes the consent requirement for loading them. Default: false.
NEXT_PUBLIC_ANALYTICS_COOKIELESS=

# ── Sanity CMS ───────────────────────────────────────────────────────────────
# When unset, the site renders its complete built-in fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only token, required only for previewing draft content.
SANITY_API_TOKEN=
# Server-only shared secret for the publish webhook (POST /api/revalidate).
# When set, publishing in Sanity refreshes the live site within seconds — no
# rebuild. Generate a random value, e.g. `openssl rand -hex 32`. Leave empty to
# keep the webhook disabled (content still refreshes hourly via ISR).
SANITY_REVALIDATE_SECRET=

# ── Supabase (optional contact-form storage + advertising analytics) ─────────
# When set, contact submissions are also stored in Supabase (see supabase/).
# The advertising system reuses the SAME Supabase project for its analytics
# tables (supabase/migrations/0002_advertising.sql). Impression/click tracking
# is only recorded when the URL + service-role key below are configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Advertising ──────────────────────────────────────────────────────────────
# Master switch for first-party impression/click tracking. Default true.
AD_TRACKING_ENABLED=true
# Business time zone for campaign scheduling. Default America/New_York.
AD_DEFAULT_TIMEZONE=America/New_York
# Dedup window for unique clicks, in hours. Default 24.
AD_UNIQUE_CLICK_WINDOW_HOURS=24
# Raw event retention, in days (older rows should be purged). Default 365.
AD_EVENT_RETENTION_DAYS=365
# When true, ads render but impressions/clicks are NEVER recorded. For admin
# previews. Default false.
AD_PREVIEW_MODE=false
# Enable sandboxed HTML/embed ads. When true, the CSP allows frame-src 'self'
# so the sandboxed ad iframe can render. Default false (keeps CSP tightest).
AD_HTML_EMBEDS_ENABLED=false
# Server-only HMAC secret for signed click-redirect tokens. Generate with
# `openssl rand -hex 32`. When unset, ads still link directly to their
# destination but individual clicks are not tracked. NEVER expose to the browser.
AD_REDIRECT_SIGNING_SECRET=
# Comma-separated host allowlist for HTML/embed and network ad scripts (Phase 2+).
AD_SCRIPT_ALLOWLIST=

# ── Advertising admin dashboard + jobs ───────────────────────────────────────
# Password for the /admin/ads dashboard and an HMAC secret for its session
# cookie. Set BOTH to enable the dashboard, or NEITHER to leave it disabled.
# Generate the secret with `openssl rand -hex 32`.
AD_ADMIN_PASSWORD=
AD_ADMIN_SESSION_SECRET=
# Bearer secret for the aggregation cron endpoint (POST /api/ads/aggregate).
# Generate with `openssl rand -hex 32`. When unset, the endpoint is disabled.
AD_CRON_SECRET=

# ── Third-party ad networks (disabled by default) ────────────────────────────
# Google AdSense stays OFF until explicitly enabled AND ad-consent is granted.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
ADSENSE_ALLOWED_DOMAINS=
