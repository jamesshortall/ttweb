# ─────────────────────────────────────────────────────────────────────────────
# Travel Technician — environment variables
#
# Copy this file to `.env.local` for local development. Every variable is
# optional for local development: the site runs with built-in fallback content
# and safely disables features whose configuration is missing.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle — never put
# secrets in them. All other variables are server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site URLs ────────────────────────────────────────────────────────────────
# Canonical site URL. Used for metadata, sitemap, canonical links, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.traveltechnician.info

# CardMaster application (separate app — this site only links to it).
NEXT_PUBLIC_CARDMASTER_URL=https://cardmaster.traveltechnician.info

# Existing Travel Technician blog (separate site — this site only links to it).
NEXT_PUBLIC_BLOG_URL=https://blog.traveltechnician.info

# ── Social ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/the_travel_technician
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/TravelTechnician

# ── Scheduling (Calendly) ────────────────────────────────────────────────────
# PLACEHOLDER — leave empty until the real Calendly event link exists.
# When empty, "Schedule a Free Consultation" buttons route to the contact form.
NEXT_PUBLIC_CALENDLY_URL=

# ── Blog RSS integration ─────────────────────────────────────────────────────
# RSS/Atom feed for blog.traveltechnician.info (e.g. https://blog.traveltechnician.info/rss.xml).
# When empty, the Blog page shows CMS-managed (or fallback) featured-post cards.
BLOG_RSS_URL=

# ── Contact form email delivery ──────────────────────────────────────────────
# Provider: "resend" | "postmark". Leave empty to log submissions server-side
# only (useful in development).
EMAIL_PROVIDER=
# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=
# Verified sender address for the chosen provider (e.g. noreply@traveltechnician.info).
EMAIL_FROM_ADDRESS=
# Provider API keys — set only the one matching EMAIL_PROVIDER.
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# ── Analytics (privacy-conscious, consent-gated) ─────────────────────────────
# Provider: "plausible" | "google". Analytics stay fully disabled unless BOTH
# provider and id/domain are set.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible: the site domain (www.traveltechnician.info). Google: the GA4 measurement ID.
NEXT_PUBLIC_ANALYTICS_ID=
# "true" only when the configured analytics are cookieless (e.g. Plausible),
# which relaxes the consent requirement for loading them. Default: false.
NEXT_PUBLIC_ANALYTICS_COOKIELESS=

# ── Sanity CMS ───────────────────────────────────────────────────────────────
# When unset, the site renders its complete built-in fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only token, required only for previewing draft content.
SANITY_API_TOKEN=

# ── Supabase (optional contact-form storage) ─────────────────────────────────
# When set, contact submissions are also stored in Supabase (see supabase/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
